                    fontSize="11"
                    fill={isDark ? "#8b949e" : "#4b5563"}
                    fontFamily="sans-serif"
                  >
                    {tick.labelBottom}
                  </text>
                </g>
              );
            })}

            <rect
              x={padLeft}
              y={padTop}
              width={plotW}
              height={plotH}
              fill="none"
              stroke={isDark ? "#30363d" : "#555555"}
              strokeWidth="1.5"
            />

            <polyline
              fill="none"
